PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/retailflow

# ── JWT ───────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ── Redis (Upstash free tier) ─────────────────────
REDIS_URL=rediss://default:password@endpoint.upstash.io:6380

# ── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ── Twilio (WhatsApp + SMS) ───────────────────────
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Email (SMTP) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ════════════════════════════════════
# WHITE LABEL CONFIG
# ════════════════════════════════════
SHOP_NAME=RetailFlow
SHOP_LOGO=
BRAND_COLOR=#2563eb

# ── Shop Mode (can combine multiple) ─────────────
GROCERY_MODE=true
PHARMACY_MODE=false
GENERAL_RETAIL_MODE=false
SUPERMARKET_MODE=false

# ── POS ───────────────────────────────────────────
SIMPLE_POS=true
ADVANCED_POS=false
BARCODE_SCANNER=false
TOUCHSCREEN_POS=false

# ── Features ──────────────────────────────────────
ONLINE_ORDERING=false
HOME_DELIVERY=false
UDHAAR_SYSTEM=true
LOYALTY_PROGRAM=false
MULTI_COUNTER=false
MULTI_BRANCH=false
GST_BILLING=true
BARCODE=true
PRESCRIPTION_SYSTEM=false
WEIGHT_BILLING=false
VARIANT_SYSTEM=false
DEPARTMENT_MANAGEMENT=false
WARRANTY_MANAGEMENT=false
SELF_CHECKOUT=false

# ── Payment Modes ─────────────────────────────────
RAZORPAY_ENABLED=true
STRIPE_ENABLED=false
COD_ENABLED=true
UPI_ENABLED=true
